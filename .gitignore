# .gitignore
# Purpose: Specifies files and directories that Git should ignore and not track.

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build artifacts
dist/
build/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating system files
.DS_Store
Thumbs.db

# Vite cache & logs
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
